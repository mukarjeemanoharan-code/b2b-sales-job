generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
}

model User {
  id        String           @id @default(cuid())
  email     String           @unique
  password  String
  name      String?
  createdAt DateTime         @default(now())
  statuses  ProspectStatus[]
}

model ProspectStatus {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId Int
  status    String   @default("new")
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
}

// confidence values used throughout: verified | likely | inference | unverified | not_found

model Company {
  id                  String    @id @default(cuid())
  name                String
  website             String?
  linkedinCompanyUrl  String?
  careersUrl          String?
  atsProvider         String? // greenhouse|lever|ashby|workable|recruitee|other|none
  atsSlug             String?
  hqCity              String?
  hqCountry           String?
  indiaOffices        Json? // string[]
  foundedYear         Int?
  headcount           Int?
  headcountSourceUrl  String?
  fundingStage        String?
  totalFunding        String?
  investors           Json? // string[]
  category            String?
  icpSummary          String?
  gtmMotion           String?
  isB2bSaas           Boolean?
  isIndiaRelevant     Boolean?
  researchStatus      String    @default("shell") // shell|queued|researched|stale
  lastResearchedAt    DateTime?
  sourceUrl           String?
  confidence          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  research     CompanyResearch?
  jobs         Job[]
  people       Person[]
  signals      Signal[]
  reviews      Review[]
  reviewThemes ReviewTheme[]
  researchGaps ResearchGap[]
  outreach     Outreach[]
  applications Application[]
}

model CompanyResearch {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  overview                       Json // {text, source_url, confidence}[]
  businessModelAndTargetMarket   Json
  leadershipAndOrgSignals        Json
  technologyStack                Json
  recentDevelopmentsAndTriggers  Json
  buyingSignalsAndIntent         Json
  competitiveLandscape           Json
  identifiedPainPoints           Json
  recommendedEngagementStrategy  Json
  accountFitAssessment           Json

  researchedAt DateTime?
  modelUsed    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ResearchGap {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  fieldName        String
  searchedAt       DateTime @default(now())
  sourcesAttempted Json?
  note             String?
  createdAt        DateTime @default(now())
}

model Review {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  reviewType      String // employee|client
  source          String?
  sourceUrl       String?
  reviewDate      DateTime?
  reviewerRole    String?
  reviewerStatus  String? // current|former
  location        String?
  rating          Float?
  ratingScale     Float?
  positives       String?
  negatives       String?
  credibilityNote String?
  confidence      String?
  ingestedVia     String? // manual_paste|api
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ReviewTheme {
  id                   String   @id @default(cuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id])
  reviewType           String
  theme                String
  sentiment            String // positive|negative|mixed
  mentionCount         Int
  representativePoints Json? // string[]
  confidence           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Person {
  id                       String   @id @default(cuid())
  companyId                String
  company                  Company  @relation(fields: [companyId], references: [id])
  fullName                 String
  title                    String?
  department               String?
  roleCategory             String? // leader|buyer_persona|influencer|champion|recruiter
  roleCategoryConfidence   String?
  linkedinUrl              String?
  linkedinUrlSource        String?
  publicEmail              String?
  publicEmailSourceUrl     String?
  workEmailPattern         String?
  workEmailPatternEvidence String?
  officeLocation           String?
  reportsTo                String?
  hiringInfluence          String? // decision_maker|hiring_manager|influencer|recruiter|interviewer|referrer
  publicActivity           Json?
  evidence                 String?
  sourceUrl                String?
  confidence               String?
  // owner-editable CRM fields, never auto-populated
  manualEmail              String?
  manualPhone              String?
  manualLinkedin           String?
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Job {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  title           String
  normalizedTitle String? // one of the nine target roles
  department      String?
  city            String?
  workMode        String? // onsite|hybrid|remote
  experienceRange String?
  salaryMin       Int?
  salaryMax       Int?
  salarySource    String?
  jdText          String?
  applyUrl        String?
  atsJobId        String?
  postedAt        DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  status          String    @default("open") // open|closed
  closeDetectedAt DateTime?
  sourceUrl       String?
  confidence      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Signal {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  type       String // funding|new_office|gtm_leader_joined|recruiter_joined|hiring_post|role_opened|role_closed|product_launch|enterprise_motion|partnership|hiring_freeze|layoff|leader_left
  eventDate  DateTime?
  detail     String
  sourceUrl  String?
  confidence String?
  weight     Int?
  origin     String?
  createdAt  DateTime  @default(now())
}

model Outreach {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  personName     String?
  status         String    @default("not_contacted")
  notes          String?
  nextActionDate DateTime?
  history        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Application {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  jobTitle       String?
  status         String    @default("wishlist")
  notes          String?
  nextActionDate DateTime?
  history        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Skill {
  id               String   @id @default(cuid())
  name             String   @unique
  category         String? // tool|skill|qualification
  mentionCount     Int      @default(0)
  exampleJobIds    Json? // string[]
  selfRating       Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
